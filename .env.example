# Required: API key for the model provider
AGENT_API_KEY=

# Optional: API base URL (default: 智谱 GLM)
# AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional: Model name (default: glm-4-flash, free tier)
# AGENT_MODEL=glm-4-flash

# Other providers:
# DeepSeek: AGENT_BASE_URL=https://api.deepseek.com/v1  AGENT_MODEL=deepseek-chat
# OpenAI:   AGENT_BASE_URL=https://api.openai.com/v1    AGENT_MODEL=gpt-4o

# Optional: Transport layer ("sdk" or "raw")
# AGENT_TRANSPORT=sdk

# Optional: Max iterations per turn
# AGENT_MAX_ITERATIONS=40

# Optional: Workspace directory (default: cwd)
# AGENT_WORKSPACE=/path/to/workspace

# Optional: Force context limit for testing compaction
# AGENT_CONTEXT_LIMIT=32000
